  "keywords": [
    "qlgydx",
    "电费",
    "校园",
    "监控"
  ],
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "sm-crypto": "^0.5.8",
    "undici": "^7.30.1"
  },
  "devDependencies": {
    "js-yaml": "^5.5.0"
  }
}
