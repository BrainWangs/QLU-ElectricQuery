{
  "name": "qlgydx-elec",
  "version": "1.0.0",
  "description": "齐鲁工业大学智慧财务电费查询 + 定时监控 + 余额预警",
  "main": "lib/qlgydx.js",
  "bin": {
    "elec": "bin/elec.js"
  },
  "scripts": {
    "query": "node bin/elec.js query",
    "check": "node bin/elec.js check",
    "watch": "node bin/elec.js watch",
    "accounts": "node bin/elec.js accounts",
    "login": "node bin/elec.js login",
    "history": "node bin/elec.js history",
    "serve": "node bin/serve.js",
    "alert-test": "node bin/elec.js alert-test",
    "test": "node --test \"test/**/*.test.js\"",
    "snapshot": "node bin/elec.js snapshot",
    "preflight": "node scripts/preflight.js --staged"
