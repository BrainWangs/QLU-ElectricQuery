      "serverchan": { "sendkey": "" },

      "wecom": { "webhook": "" },

      "bark": { "url": "" },

      "telegram": { "token": "", "chatId": "" }
    }
  },
  "storage": {
    "stateFile": "data/state.json",
    "historyFile": "data/history.jsonl",
    "logFile": "data/watch.log",
    "latestFile": "data/latest.json",
